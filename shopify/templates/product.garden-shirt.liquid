{% layout none %}
{%- assign p = product -%}
{%- assign v = product.selected_or_first_available_variant | default: product.variants.first -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Little Gardener Embroidered Linen Shirt | Baby Bling</title>
<meta name="description" content="A pale sage linen Cuban collar shirt with a hand-embroidered houseplant and watering can in dark green thread. Breathable linen, coconut wood buttons, itch-free patch. By Baby Bling.">
<meta name="theme-color" content="#E3AE88">
<meta property="og:title" content="Little Gardener Embroidered Linen Shirt — Baby Bling">
<meta property="og:description" content="Featherlight linen cotton. Hand embroidered. Made for real play.">
<meta property="og:image" content="{{ 'bg-shirt.webp' | asset_url }}">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎈</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════ TOKENS ══════════════════════════ */
:root{
  --sky-0:#C0653F; --sky-1:#DB9670; --sky-2:#EFC0A4; --sky-3:#FAE6D8;
  --cream:#FFFBF6; --cream-2:#FFF3E9;
  --peach:#F7C9B0; --peach-2:#FBE0D2; --peach-deep:#E79C7B;
  --ink:#0E2F4C; --ink-2:#3B6285; --ink-3:#7495AF;
  --red:#D63B31; --blue:#2F63D8; --wood:#B07A45; --green:#219767;
  --line:rgba(14,47,76,.10);
  --glass:rgba(255,255,255,.80);
  --shadow-s:0 2px 10px rgba(30,90,140,.10);
  --shadow-m:0 14px 34px -12px rgba(30,90,140,.34);
  --shadow-l:0 36px 80px -26px rgba(24,80,130,.48);
  --r-s:16px; --r-m:24px; --r-l:34px; --r-xl:44px;
  --pad:clamp(18px,5vw,64px);
  --maxw:1240px;
  --bar-h:0px;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%;background:var(--sky-2)}
body{
  font-family:'Outfit',system-ui,-apple-system,'Segoe UI',sans-serif;
  color:var(--ink); background:transparent;
  overflow-x:hidden; line-height:1.6;
  font-size:clamp(15px,1.05vw + 12px,17px);
  padding-bottom:var(--bar-h);
}
img{max-width:100%;height:auto;display:block}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer}
a{color:inherit;text-decoration:none}
h1,h2,h3,.disp{font-family:'Fredoka',system-ui,sans-serif;font-weight:600;line-height:1.03;letter-spacing:-.022em}
.wrap{width:100%;max-width:var(--maxw);margin-inline:auto;padding-inline:var(--pad)}
.eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);opacity:.75}

/* ══════════════════════════ GLOBAL SKY ══════════════════════════ */
#skybg{position:fixed;inset:0;z-index:-2;overflow:hidden;pointer-events:none;contain:strict}
#grad{position:absolute;left:0;right:0;top:0;height:300%;will-change:transform;
  background:linear-gradient(180deg,
    #F4D6C2 0%, #F0CCB4 8%, #ECC2A6 17%,
    #E7B795 27%, #E3AE88 34%, #DFA47C 42%,
    #D89568 52%, #E9BB9E 62%, #FBE4D4 70%,
    #F6CDB6 76%, #E6B597 85%, #CE7E55 93%, #BC6440 100%)}
#sun{position:absolute;top:-10vh;right:-14vw;width:min(70vw,700px);aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle,rgba(255,240,215,.95),rgba(252,206,164,.55) 34%,rgba(248,190,150,0) 68%);
  will-change:transform}
#cloudfield{position:absolute;inset:0}

/* one puffy cloud */
.cl{position:absolute;left:0;top:0;will-change:transform;
  filter:drop-shadow(0 14px 22px rgba(150,80,50,.22))}
.cl i{position:absolute;background:#fff;border-radius:999px;display:block;
  box-shadow:inset 0 -16px 26px -16px rgba(190,115,80,.44)}
.cl .b {left:2%;  bottom:0;   width:96%; height:46%; border-radius:999px}
.cl .l1{left:4%;  bottom:16%; width:44%; height:74%; border-radius:50%}
.cl .l2{left:26%; bottom:26%; width:52%; height:96%; border-radius:50%}
.cl .l3{right:2%; bottom:14%; width:40%; height:66%; border-radius:50%}
.cl .l4{left:16%; bottom:30%; width:30%; height:56%; border-radius:50%}
.cl .l5{right:20%;bottom:34%; width:26%; height:50%; border-radius:50%}
.cl.soft i{background:rgba(255,255,255,.70);box-shadow:none}
.cl.mist i{background:rgba(255,255,255,.42);box-shadow:none}
.cl.warm i{background:#fff;box-shadow:inset 0 -18px 30px -16px rgba(214,128,92,.38)}

@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
@keyframes floaty{0%,100%{transform:translate3d(0,0,0) rotate(0deg)}50%{transform:translate3d(0,-22px,0) rotate(.6deg)}}
@keyframes swayA{0%,100%{transform:translate(0,0) rotate(-4deg)}50%{transform:translate(10px,-26px) rotate(4deg)}}
@keyframes swayB{0%,100%{transform:translate(0,0) rotate(3deg)}50%{transform:translate(-12px,-32px) rotate(-3deg)}}
@keyframes shadowPulse{0%,100%{transform:translateX(-50%) scale(1);opacity:.30}50%{transform:translateX(-50%) scale(.86);opacity:.16}}
@keyframes marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes pop{0%{transform:scale(.6);opacity:0}60%{transform:scale(1.08);opacity:1}100%{transform:scale(1);opacity:1}}
@keyframes nudge{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-7px)}40%,80%{transform:translateX(7px)}}
@keyframes riseFade{from{opacity:1;transform:translateY(0) scale(1)}to{opacity:0;transform:translateY(-190px) scale(1.25)}}
@keyframes live{0%{box-shadow:0 0 0 0 rgba(214,59,49,.55)}70%{box-shadow:0 0 0 9px rgba(214,59,49,0)}100%{box-shadow:0 0 0 0 rgba(214,59,49,0)}}

/* ══════════════════════════ TICKER / NAV ══════════════════════════ */
.ticker{background:var(--ink);color:#fff;overflow:hidden;position:relative;z-index:60;font-size:.78rem;letter-spacing:.03em}
.ticker .track{display:flex;width:max-content;animation:marq 34s linear infinite}
.ticker span{padding:9px 0;display:inline-flex;align-items:center;gap:10px;white-space:nowrap}
.ticker span::after{content:"✦";opacity:.5;margin:0 22px}

#nav{position:sticky;top:0;z-index:55;transition:background .3s,box-shadow .3s,backdrop-filter .3s}
#nav.stuck{background:rgba(255,255,255,.66);backdrop-filter:blur(18px) saturate(1.5);
  box-shadow:0 1px 0 rgba(255,255,255,.6),0 10px 30px -22px rgba(20,70,110,.9)}
.nav-in{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:12px}
.logo{display:flex;align-items:center;gap:9px;font-family:'Fredoka';font-weight:600;font-size:1.16rem}
.logo .dot{width:28px;height:28px;border-radius:50%;background:linear-gradient(150deg,var(--red),#ff7a5c);position:relative;flex:none;box-shadow:0 4px 10px -3px rgba(214,59,49,.6)}
.logo .dot::after{content:"";position:absolute;width:18px;height:18px;border-radius:50%;background:linear-gradient(150deg,var(--blue),#6b95ff);right:-9px;top:9px;box-shadow:0 4px 10px -3px rgba(47,99,216,.5)}
.logo b{font-weight:600;margin-left:10px}
.nav-links{display:none;gap:28px;font-size:.93rem;font-weight:500}
.nav-links a{position:relative;padding:4px 0;color:var(--ink-2)}
.nav-links a::after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--red);border-radius:2px;transition:width .25s}
.nav-links a:hover{color:var(--ink)}.nav-links a:hover::after{width:100%}
.nav-cta{display:flex;align-items:center;gap:10px}
.cart-btn{position:relative;width:42px;height:42px;border-radius:50%;background:rgba(255,255,255,.85);box-shadow:var(--shadow-s);display:grid;place-items:center;transition:transform .2s}
.cart-btn:active{transform:scale(.92)}
.cart-btn .cnt{position:absolute;top:-3px;right:-3px;min-width:19px;height:19px;border-radius:10px;background:var(--red);color:#fff;font-size:.66rem;font-weight:700;display:grid;place-items:center;padding:0 5px;opacity:0;transform:scale(.5);transition:.25s cubic-bezier(.34,1.56,.64,1)}
.cart-btn .cnt.on{opacity:1;transform:scale(1)}
@media(min-width:920px){.nav-links{display:flex}}

/* ══════════════════════════ BUTTONS ══════════════════════════ */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:600;
  border-radius:999px;padding:16px 30px;font-size:1rem;
  transition:transform .18s cubic-bezier(.34,1.4,.64,1),box-shadow .25s,background .25s;will-change:transform;text-align:center}
.btn:active{transform:scale(.97)}
.btn-primary{background:linear-gradient(160deg,#e8483d,var(--red));color:#fff;
  box-shadow:0 14px 30px -10px rgba(214,59,49,.85),inset 0 1px 0 rgba(255,255,255,.32)}
.btn-primary:hover{box-shadow:0 20px 38px -10px rgba(214,59,49,.9);transform:translateY(-2px)}
.btn-ghost{background:rgba(255,255,255,.78);color:var(--ink);box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.9),0 8px 22px -12px rgba(20,70,110,.7);backdrop-filter:blur(10px)}
.btn-ghost:hover{background:#fff}
.btn-dark{background:var(--ink);color:#fff;box-shadow:0 14px 30px -12px rgba(14,47,76,.95)}
.btn-block{width:100%}

/* ══════════════════════════ HERO ══════════════════════════ */
.hero{position:relative;isolation:isolate;padding-top:clamp(2px,1.4vw,22px);padding-bottom:clamp(34px,6vw,80px)}
.hero-in{position:relative;z-index:2;display:grid;gap:clamp(8px,2.4vw,22px);align-items:center}
.hero-top{order:0;text-align:center}
.stage{order:1}
.hero-bottom{order:2;text-align:center}
@media(min-width:960px){
  .hero-in{grid-template-columns:1.02fr .98fr;grid-template-rows:auto auto;
           column-gap:clamp(24px,3vw,56px);row-gap:0;align-items:center}
  .hero-top{grid-column:1;grid-row:1;text-align:left;align-self:end}
  .hero-bottom{grid-column:1;grid-row:2;text-align:left;align-self:start}
  .stage{grid-column:2;grid-row:1 / span 2}
  .hero{padding-bottom:clamp(56px,8vw,120px)}
}
.badge-row{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:16px}
@media(min-width:960px){.badge-row{justify-content:flex-start}}
.pill{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.82);backdrop-filter:blur(10px);
  border-radius:999px;padding:7px 14px;font-size:.76rem;font-weight:600;color:var(--ink-2);
  box-shadow:0 6px 16px -8px rgba(20,70,110,.6),inset 0 0 0 1px rgba(255,255,255,.7)}
.pill .em{font-size:.9rem;line-height:1}
h1{font-size:clamp(2.4rem,8.8vw,4.5rem);letter-spacing:-.035em;
  text-shadow:0 2px 26px rgba(255,255,255,.9),0 0 60px rgba(255,255,255,.75)}
h1 .line2{display:block;background:linear-gradient(100deg,#1F5138 6%,#7A4A2A 44%,#234C5C 94%);
  -webkit-background-clip:text;background-clip:text;color:transparent}
.dk{display:none}
@media(min-width:960px){.dk{display:block}}
.tax-note{font-size:.84rem;color:var(--ink-2);margin-top:4px;opacity:.85}
.qty-row{display:flex;align-items:center;gap:14px;margin-top:18px;justify-content:center;flex-wrap:wrap}
.urg{display:inline-flex;align-items:center;gap:8px;font-size:.84rem;color:var(--ink-2)}
.opt-label{margin-top:22px}
.hero .sizes{grid-template-columns:repeat(3,1fr);max-width:430px;margin-inline:auto}
.hero .opt-label{max-width:430px;margin-inline:auto}
.hero .size{background:rgba(255,255,255,.78);backdrop-filter:blur(8px);
  box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.9),0 6px 16px -10px rgba(20,70,110,.8)}
.hero .size:hover{background:#fff}
.hero .size.sel{background:var(--ink);color:#fff;box-shadow:0 10px 22px -8px rgba(14,47,76,.9)}
.hero .qty{background:rgba(255,255,255,.78);backdrop-filter:blur(8px);
  box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.9)}
.stage .bv-thumbs{margin-top:18px}
@media(min-width:960px){
  .hero .sizes,.hero .opt-label{margin-inline:0}
  .qty-row,.opt-label{justify-content:flex-start}
}
.hero-tag{margin-top:12px;font-size:clamp(.95rem,1vw + .72rem,1.1rem);font-weight:500;color:var(--ink-2);letter-spacing:.005em}
.hero-sub{margin-top:8px;font-size:clamp(1rem,1.1vw + .8rem,1.16rem);color:var(--ink-2);max-width:30ch;margin-inline:auto}
@media(min-width:960px){.hero-sub{margin-inline:0;max-width:34ch}
  .hero .opt-label{text-align:left}}
.price-row{display:flex;align-items:baseline;gap:12px;justify-content:center;margin-top:18px;flex-wrap:wrap}
@media(min-width:960px){.price-row{justify-content:flex-start}}
.price{font-family:'Fredoka';font-size:2rem;font-weight:600}
.mrp{text-decoration:line-through;color:var(--ink-3);font-size:1.05rem}
.save{background:#D8F3E6;color:var(--green);font-weight:700;font-size:.76rem;padding:5px 11px;border-radius:999px}
.hero-actions{display:flex;flex-direction:column;gap:10px;margin-top:18px;max-width:420px;margin-inline:auto}
@media(min-width:960px){.hero-actions{margin-inline:0;flex-direction:row;max-width:none}}
.microtrust{margin-top:14px;font-size:.82rem;color:var(--ink-2);display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
@media(min-width:960px){.microtrust{justify-content:flex-start}}
.microtrust b{font-weight:600}

/* 3D floating shirt */
.stage{position:relative;perspective:1300px;perspective-origin:50% 45%;display:grid;place-items:center;
  padding-block:clamp(0px,1vw,18px)}
.shirt-scene{position:relative;width:min(72vw,470px);aspect-ratio:883/824;transform-style:preserve-3d;will-change:transform;
  transition:transform .5s cubic-bezier(.22,1,.36,1)}
.shirt-float{position:absolute;inset:0;animation:floaty 7s ease-in-out infinite;transform-style:preserve-3d}
.shirt-img{width:100%;height:100%;object-fit:contain;
  filter:drop-shadow(0 40px 34px rgba(20,70,110,.28)) drop-shadow(0 8px 10px rgba(20,70,110,.12));
  transform:translateZ(60px)}
.shirt-halo{position:absolute;left:50%;top:48%;width:118%;aspect-ratio:1;translate:-50% -50%;
  background:radial-gradient(circle,rgba(255,255,255,.92),rgba(255,255,255,.5) 40%,rgba(255,255,255,0) 68%);
  z-index:-1;filter:blur(8px)}
.ground{position:absolute;left:50%;bottom:-3%;width:56%;height:26px;border-radius:50%;
  background:radial-gradient(ellipse,rgba(20,70,110,.34),rgba(20,70,110,0) 70%);filter:blur(9px);
  transform:translateX(-50%);animation:shadowPulse 7s ease-in-out infinite}
.bln{position:absolute;width:clamp(22px,5vw,40px);z-index:3;filter:drop-shadow(0 10px 14px rgba(20,70,110,.24))}
.bln.a{left:-7%;top:6%;animation:swayA 6s ease-in-out infinite;transform:translateZ(60px)}
.bln.b{right:-7%;top:24%;width:clamp(22px,5vw,40px);animation:swayB 7.6s ease-in-out infinite;transform:translateZ(60px)}
.bln.c{left:-4%;bottom:4%;width:clamp(18px,4vw,30px);opacity:.8;animation:swayA 9s ease-in-out infinite reverse}

.cue{position:absolute;left:50%;bottom:6px;translate:-50% 0;z-index:4;display:none;flex-direction:column;align-items:center;gap:6px;
  font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-2);opacity:.7}
@media(min-width:960px){.cue{display:flex}}
.cue .mouse{width:22px;height:34px;border-radius:12px;border:1.6px solid currentColor;position:relative}
.cue .mouse::after{content:"";position:absolute;left:50%;top:6px;translate:-50% 0;width:3px;height:6px;border-radius:2px;background:currentColor;animation:bob 1.8s ease-in-out infinite}

/* ══════════════════════════ MARQUEE STRIP ══════════════════════════ */
.strip{background:var(--ink);color:#fff;overflow:hidden;padding:14px 0;border-radius:999px;
  margin-inline:auto;max-width:calc(var(--maxw) - 2 * var(--pad));box-shadow:var(--shadow-m)}
.strip-hold{padding-inline:var(--pad)}
.strip .track{display:flex;width:max-content;animation:marq 30s linear infinite}
.strip .track:hover{animation-play-state:paused}
.strip i{font-style:normal;display:inline-flex;align-items:center;gap:12px;padding:0 26px;white-space:nowrap;
  font-family:'Fredoka';font-size:clamp(1rem,2.4vw,1.35rem);font-weight:500}
.strip i em{font-style:normal;color:var(--peach)}

/* ══════════════════════════ SECTIONS ══════════════════════════ */
section{position:relative}
.sec{padding-block:clamp(52px,8.5vw,116px)}
.sec-head{text-align:center;max-width:660px;margin:0 auto clamp(30px,5vw,56px)}
.sec-head h2{font-size:clamp(1.95rem,5.8vw,3.2rem);margin-top:12px;text-shadow:0 2px 20px rgba(255,255,255,.6)}
.sec-head p{margin-top:14px;color:var(--ink-2);font-size:1.03rem}

/* frosted panel that floats on the sky */
.panel{background:rgba(255,255,255,.62);backdrop-filter:blur(22px) saturate(1.25);
  border-radius:var(--r-xl);box-shadow:var(--shadow-l),inset 0 0 0 1px rgba(255,255,255,.75);
  padding:clamp(24px,5vw,64px) clamp(18px,4vw,54px)}

.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(8px,2vw,22px);text-align:center}
.stat{background:#fff;border-radius:var(--r-m);padding:clamp(16px,3vw,30px) clamp(8px,2vw,20px);box-shadow:var(--shadow-m)}
.stat .n{font-family:'Fredoka';font-size:clamp(1.5rem,5.6vw,2.7rem);font-weight:600;line-height:1;
  background:linear-gradient(140deg,var(--red),var(--blue));-webkit-background-clip:text;background-clip:text;color:transparent}
.stat .l{margin-top:8px;font-size:clamp(.72rem,2.2vw,.88rem);color:var(--ink-2);font-weight:500;line-height:1.35}

.details{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(12px,2.4vw,26px)}
@media(min-width:900px){.details{grid-template-columns:repeat(4,1fr)}}
.dcard{background:#fff;border-radius:var(--r-m);padding:14px 14px 20px;box-shadow:var(--shadow-m);text-align:center;
  transition:transform .35s cubic-bezier(.22,1,.36,1),box-shadow .35s}
.dcard:hover{transform:translateY(-8px);box-shadow:var(--shadow-l)}
.dzoom{width:100%;aspect-ratio:1;border-radius:18px;object-fit:cover;background:#FFF3EC;
  box-shadow:inset 0 0 0 1px rgba(14,47,76,.06)}
.dcard h3{margin-top:14px;font-size:1.02rem}
.dcard p{margin-top:6px;font-size:.85rem;color:var(--ink-2);line-height:1.5}

.split{display:grid;gap:clamp(24px,4vw,60px);align-items:center}
@media(min-width:900px){.split{grid-template-columns:1fr 1fr}}
.fabric-card{position:relative;border-radius:var(--r-xl);overflow:hidden;box-shadow:var(--shadow-l);
  aspect-ratio:3/4;background:var(--cream-2);margin:0}
.fabric-card img{width:100%;height:100%;object-fit:cover;display:block}
.feature-list{list-style:none;display:grid;gap:14px;margin-top:26px}
.feature-list li{display:flex;gap:14px;align-items:flex-start}
.feature-list .ic{flex:none;width:34px;height:34px;border-radius:11px;display:grid;place-items:center;font-size:1rem;
  background:rgba(255,255,255,.9);box-shadow:var(--shadow-s)}
.feature-list b{display:block;font-weight:600}
.feature-list span{font-size:.9rem;color:var(--ink-2)}

.bv-thumbs{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:14px;max-width:100%}
.hero-in>*{min-width:0}
@media(max-width:560px){.bv-thumbs{gap:5px}.bv-thumbs .bvt{width:42px;height:42px;border-radius:11px}}
.bvt{width:60px;height:60px;border-radius:14px;overflow:hidden;background:rgba(255,255,255,.85);
  box-shadow:0 6px 16px -8px rgba(20,70,110,.7),inset 0 0 0 1.5px rgba(255,255,255,.9);transition:.2s}
.bvt img{width:100%;height:100%;object-fit:cover}
.bvt.sel{box-shadow:0 0 0 2.5px var(--ink),0 8px 18px -8px rgba(20,70,110,.8)}
.bvt:hover{transform:translateY(-2px)}
@media(min-width:960px){
    }
.stars{color:#F5A623;letter-spacing:1px}
.opt-label{display:flex;justify-content:space-between;align-items:baseline;margin:24px 0 10px;font-size:.85rem;font-weight:600}
.opt-label a{color:var(--blue);font-weight:600;font-size:.8rem;border-bottom:1px dashed currentColor}
.sizes{display:grid;grid-template-columns:repeat(auto-fit,minmax(72px,1fr));gap:8px}
.size{padding:12px 4px;border-radius:14px;background:var(--cream);box-shadow:inset 0 0 0 1.5px var(--line);
  font-weight:600;font-size:.88rem;text-align:center;transition:.2s;position:relative}
.size:hover{box-shadow:inset 0 0 0 1.5px var(--ink-3)}
