<script>
window.__BB__ = {
  handle:    {{ p.handle | json }},
  title:     {{ p.title | json }},
  variantId: {{ v.id | default: 0 | json }},
  price:     {{ v.price | default: 0 | json }},
  available: {{ v.available | default: false | json }},
  optionNames: {{ p.options | json }},
  variants: [
    {%- for var in p.variants -%}
    { id: {{ var.id }}, title: {{ var.title | json }}, price: {{ var.price }},
      available: {{ var.available | json }}, options: {{ var.options | json }} }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
};
(function(){
'use strict';
var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ═══════════ FULL-PAGE CLOUD FIELD ═══════════ */
var field = document.getElementById('cloudfield');
var grad  = document.getElementById('grad');
var sun   = document.getElementById('sun');
var clouds = [];
var vh = innerHeight, vw = innerWidth;

/* Clouds live in a virtual band taller than the viewport and are recycled as
   you scroll, so the whole document — top to bottom — sits inside cloud cover. */
function buildClouds(){
  field.innerHTML=''; clouds=[];
  vh = innerHeight; vw = innerWidth;
  var n = vw < 700 ? 15 : 23;
  var BAND = vh * 1.9;                       // virtual height clouds wrap within
  for(var i=0;i<n;i++){
    var layer = i % 3;                        // 0 far, 1 mid, 2 near
    var w = (layer===0 ? 90+Math.random()*110
           : layer===1 ? 170+Math.random()*180
           : 280+Math.random()*300) * (vw<700 ? .78 : 1);
    var cls = layer===0 ? 'mist' : (layer===1 ? (Math.random()<.35?'soft':'') : (Math.random()<.3?'warm':''));
    var d = document.createElement('div');
    d.className = 'cl ' + cls;
    d.style.width = w+'px';
    d.style.height = (w*0.46)+'px';
    d.style.opacity = layer===0 ? .32 : (layer===1 ? .55 : .72);
    d.style.filter = 'drop-shadow(0 14px 22px rgba(150,80,50,'+(layer===2?.12:.05)+'))'+
                     (layer===0?' blur(2.5px)':(layer===1?' blur(.6px)':''));
    d.style.zIndex = layer;
    d.innerHTML = '<i class="b"></i><i class="l1"></i><i class="l2"></i><i class="l3"></i><i class="l4"></i><i class="l5"></i>';
    field.appendChild(d);
    clouds.push({
      el:d,
      x: -w*0.4 + Math.random()*(vw + w*0.8),
      y: Math.random()*BAND,
      w:w,
      band:BAND,
      depth: layer===0 ? 0.14 : (layer===1 ? 0.34 : 0.62),   // parallax factor
      drift: (layer+1) * (Math.random()<.5?-1:1) * (2+Math.random()*5), // px/s sideways
      bobA: 4+Math.random()*9,
      bobT: 4+Math.random()*7,
      ph: Math.random()*Math.PI*2
    });
  }
  place(scrollY, performance.now()/1000);
}

function place(sy, t){
  var docH = Math.max(1, document.documentElement.scrollHeight - vh);
  var prog = Math.min(1, sy/docH);
  grad.style.transform = 'translate3d(0,'+(-prog*(grad.offsetHeight - vh)*0.62)+'px,0)';
  sun.style.transform  = 'translate3d('+(prog*90)+'px,'+(sy*0.10 + prog*60)+'px,0) scale('+(1-prog*0.25)+')';
  for(var i=0;i<clouds.length;i++){
    var c=clouds[i];
    var y = c.y - sy*c.depth;
    /* wrap within the virtual band so clouds never run out */
    y = ((y % c.band) + c.band) % c.band - c.band*0.35;
    var x = c.x + (reduce?0:t*c.drift);
    var span = vw + c.w*1.2;
    x = ((x + c.w) % span + span) % span - c.w;
    var bob = reduce ? 0 : Math.sin(t/c.bobT + c.ph)*c.bobA;
    c.el.style.transform = 'translate3d('+x.toFixed(1)+'px,'+(y+bob).toFixed(1)+'px,0)';
  }
}

var lastSY = 0, running = false;
function frame(){
  var t = performance.now()/1000;
  place(lastSY, t);
  if(!reduce) requestAnimationFrame(frame); else running=false;
}
addEventListener('scroll',function(){ lastSY = scrollY; if(reduce) place(lastSY,0); },{passive:true});
var rz; addEventListener('resize',function(){ clearTimeout(rz); rz=setTimeout(buildClouds,250); });
buildClouds(); lastSY = scrollY; frame();

/* ═══════════ 3D shirt tilt ═══════════ */
var scene = document.getElementById('scene');
var tx=0,ty=0,cx=0,cy=0,raf=null;
function loop(){
  cx += (tx-cx)*0.08; cy += (ty-cy)*0.08;
  scene.style.transform='rotateX('+cy.toFixed(2)+'deg) rotateY('+cx.toFixed(2)+'deg)';
  if(Math.abs(tx-cx)>0.01||Math.abs(ty-cy)>0.01){raf=requestAnimationFrame(loop);} else {raf=null;}
}
function kick(){ if(!raf) raf=requestAnimationFrame(loop); }
if(!reduce && matchMedia('(hover:hover)').matches){
  addEventListener('pointermove',function(e){
    var r=scene.getBoundingClientRect();
    tx = ((e.clientX-(r.left+r.width/2))/innerWidth)*26;
    ty = -((e.clientY-(r.top+r.height/2))/innerHeight)*18;
    scene.style.transition='none'; kick();
  },{passive:true});
}
if(!reduce && window.DeviceOrientationEvent && !matchMedia('(hover:hover)').matches){
  addEventListener('deviceorientation',function(e){
    if(e.gamma==null) return;
    tx = Math.max(-20,Math.min(20, e.gamma*0.6));
    ty = Math.max(-14,Math.min(14, (e.beta-45)*0.28));
    scene.style.transition='none'; kick();
  },{passive:true});
}

/* ═══════════ detail zoom bubbles ═══════════ */
/* ═══════════ product gallery ═══════════ */
var bvMain=document.querySelector('.shirt-img');
if(bvMain){
  document.querySelectorAll('.bvt').forEach(function(b){
    b.addEventListener('click',function(){
      document.querySelectorAll('.bvt').forEach(function(o){o.classList.remove('sel');});
      b.classList.add('sel');
      bvMain.style.opacity=0;
      var im=new Image();
      im.onload=function(){ bvMain.src=b.dataset.src; bvMain.style.opacity=1; };
      im.src=b.dataset.src;
    });
  });
}

/* ═══════════ origin swipe dots ═══════════ */
(function(){ var row=document.getElementById('originRow'), dots=document.querySelectorAll('#originDots i');
  if(!row||!dots.length) return;
  row.addEventListener('scroll',function(){ var kids=row.children, c=row.scrollLeft+row.clientWidth/2, best=0, bd=1e9;
    for(var i=0;i<kids.length;i++){ var k=kids[i], m=k.offsetLeft+k.offsetWidth/2, d=Math.abs(m-c); if(d<bd){bd=d;best=i;} }
    dots.forEach(function(d,i){ d.classList.toggle('on',i===best); }); },{passive:true});
})();

/* ═══════════ fabric: feather parallax + weave lens ═══════════ */
(function(){
  var fb=document.querySelector('.feather'), fi=document.querySelector('.feather-img');
  if(fb && fi && !reduce){
    var tick=false;
    addEventListener('scroll',function(){ if(tick) return; tick=true; requestAnimationFrame(function(){
      tick=false; var r=fb.getBoundingClientRect(); if(r.bottom<0||r.top>innerHeight) return;
      var p=(r.top+r.height/2-innerHeight/2)/innerHeight;
      fi.style.transform='translate3d(0,'+(p*-7).toFixed(2)+'%,0)'; }); },{passive:true});
  }
  var box=document.getElementById('weaveBox'), lens=document.getElementById('lens');
  if(!box||!lens) return;
  var img=box.querySelector('img'), Z=2.6, set=false;
  function geo(){ var r=box.getBoundingClientRect(), iw=img.naturalWidth||2000, ih=img.naturalHeight||1116;
    var k=Math.max(r.width/iw, r.height/ih); return {r:r, w:iw*k, h:ih*k, ox:(r.width-iw*k)/2, oy:(r.height-ih*k)/2}; }
  function place(cx,cy){
    var g=geo(), x=Math.max(0,Math.min(g.r.width,cx-g.r.left)), y=Math.max(0,Math.min(g.r.height,cy-g.r.top));
    if(!set){ lens.style.backgroundImage='url("'+(img.currentSrc||img.src)+'")'; set=true; }
    var L=lens.offsetWidth;
    lens.style.left=x+'px'; lens.style.top=y+'px';
    lens.style.backgroundSize=(g.w*Z)+'px '+(g.h*Z)+'px';
    lens.style.backgroundPosition=(-((x-g.ox)*Z-L/2))+'px '+(-((y-g.oy)*Z-L/2))+'px';
  }
  function centre(){ var r=box.getBoundingClientRect(); place(r.left+r.width*.62, r.top+r.height*.5); }
  box.addEventListener('pointermove',function(e){ place(e.clientX,e.clientY); });
  box.addEventListener('pointerdown',function(e){ place(e.clientX,e.clientY); });
  box.addEventListener('pointerleave',function(e){ if(e.pointerType==='mouse') centre(); });
  addEventListener('resize',centre,{passive:true});
  if(img.complete && img.naturalWidth) centre(); else img.addEventListener('load',centre);
  new IntersectionObserver(function(en){ en.forEach(function(e){ if(e.isIntersecting) centre(); }); }).observe(box);
})();

/* ═══════════ reveal ═══════════ */
var io = new IntersectionObserver(function(en){
  en.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('vis'); io.unobserve(e.target); } });
},{threshold:.12,rootMargin:'0px 0px -8% 0px'});
document.querySelectorAll('.rev').forEach(function(e){io.observe(e);});

/* ═══════════ nav ═══════════ */
var nav=document.getElementById('nav');
addEventListener('scroll',function(){ nav.classList.toggle('stuck', scrollY>16); },{passive:true});

/* ═══════════ FAQ ═══════════ */
document.querySelectorAll('.q').forEach(function(q){
  var btn=q.querySelector('button'), a=q.querySelector('.a');
  btn.addEventListener('click',function(){
    var open=q.classList.toggle('open');
    a.style.maxHeight = open ? a.scrollHeight+'px' : 0;
  });
});

/* ═══════════ product ═══════════ */
var BB = window.__BB__ || {};
var FALLBACK_PRICE = 1699;                 /* used only if Shopify price is 0 */
var PRICE = (BB.price || 0)/100;
if (PRICE <= 0) PRICE = FALLBACK_PRICE;
var FREE_AT = 999;
function inrRaw(n){ return '\u20b9'+Number(n).toLocaleString('en-IN'); }
document.querySelectorAll('.price').forEach(function(el){
  el.textContent = PRICE > 0 ? inrRaw(PRICE) : 'Price coming soon'; });
var state={size:null,qty:1,colour:'Pale Sage',variantId:0,sizeIndex:-1};
var sizesEl=document.getElementById('sizes');
/* Real Size option in Shopify? Build the picker from the actual variants. */
(function(){
  var names=(BB.optionNames||[]).map(function(o){return (o.name||o).toString().toLowerCase();});
  var ix=names.indexOf('size');
  if(ix<0 || !(BB.variants||[]).length || BB.variants.length<2) return;
  state.sizeIndex=ix;
  sizesEl.innerHTML = BB.variants.map(function(vr){
    var label=(vr.options[ix]||vr.title||'').toString();
    var num=label.replace(/\s*years?\s*/i,'').trim()||label;
    return '<button class="size'+(vr.available?'':' out')+'" data-size="'+label+
           '" data-vid="'+vr.id+'"'+(vr.available?'':' disabled')+'>'+num+
           '<small>'+(vr.available?'years':'sold out')+'</small></button>';
  }).join('');
})();
var bbSize=document.getElementById('bbSize');


sizesEl.addEventListener('click',function(e){
  var b=e.target.closest('.size'); if(!b||b.disabled) return;
  sizesEl.querySelectorAll('.size').forEach(function(s){s.classList.remove('sel');});
  b.classList.add('sel');
  state.size=b.dataset.size;
  if(b.dataset.vid){
    state.variantId=+b.dataset.vid;
    var chosen=(BB.variants||[]).filter(function(x){return x.id===state.variantId;})[0];
    if(chosen){ PRICE=chosen.price/100; BB.available=chosen.available;
      document.querySelectorAll('.price').forEach(function(el){
        el.textContent=PRICE>0?inrRaw(PRICE):'Price coming soon'; });
      syncAddBtn(); }
  }
  bbSize.textContent=(PRICE>0?inr(PRICE):'Price coming soon')+' · Size '+state.size;
});



var qVal=document.getElementById('qVal');
document.getElementById('qPlus').onclick=function(){ state.qty=Math.min(9,state.qty+1); qVal.textContent=state.qty; syncAddBtn(); };
document.getElementById('qMinus').onclick=function(){ state.qty=Math.max(1,state.qty-1); qVal.textContent=state.qty; syncAddBtn(); };
function inr(n){ return '₹'+n.toLocaleString('en-IN'); }
function syncAddBtn(){ document.getElementById('addBtn').textContent = PRICE>0 ? ('Add to cart — '+inr(PRICE*state.qty)) : 'Add to cart'; }

/* ═══════════ cart ═══════════ */
var cart=document.getElementById('cart'), scrim=document.getElementById('scrim');
function openCart(){ cart.classList.add('on'); scrim.classList.add('on'); document.body.style.overflow='hidden'; }
function closeCart(){ cart.classList.remove('on'); scrim.classList.remove('on'); document.body.style.overflow=''; }
document.getElementById('openCart').onclick=openCart;
document.getElementById('closeCart').onclick=closeCart;
scrim.onclick=closeCart;
addEventListener('keydown',function(e){ if(e.key==='Escape') closeCart(); });

function renderCart(cart){
  var body=document.getElementById('cartBody');
  var cc=document.getElementById('cartCount');
  var items=(cart&&cart.items)||[];
  var n=(cart&&cart.item_count)||0;
  var sub=((cart&&cart.total_price)||0)/100;
  cc.textContent=n; cc.classList.toggle('on',n>0);
  document.getElementById('subTot').textContent=inr(sub);
  document.getElementById('freeFill').style.width=Math.min(100, FREE_AT?sub/FREE_AT*100:0)+'%';
  document.getElementById('freeNote').innerHTML = sub>=FREE_AT
    ? '\ud83c\udf89 You\u2019ve unlocked <b>free shipping</b>!'
    : 'Add <b>'+inr(Math.max(0,FREE_AT-sub))+'</b> more for free shipping';
  if(!items.length){ body.innerHTML='<div class="cart-empty">Your bag is feeling light.<br>Just like the shirt.</div>'; return; }
  body.innerHTML = items.map(function(i){
    var size=(i.properties&&i.properties.Size)?i.properties.Size:(i.variant_title||'');
    var img=i.image ? i.image.replace(/(\.[a-z]+)(\?|$)/i,'_160x$1$2') : '';
    return '<div class="ci"><img src="'+img+'" alt=""><div class="info"><b>'+i.product_title+'</b>'+
      '<small>'+size+'</small><div class="row"><span>'+inr(i.line_price/100)+' \u00d7 '+i.quantity+'</span>'+
      '<button class="rm" data-key="'+i.key+'">Remove</button></div></div></div>';
  }).join('<div style="height:10px"></div>');
  body.querySelectorAll('.rm').forEach(function(b){
    b.onclick=function(){
      fetch('/cart/change.js',{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({id:b.dataset.key,quantity:0})})
        .then(function(r){return r.json();}).then(renderCart);
    };
  });
}

function balloonBurst(x,y){
  if(reduce) return;
  var cols=['#D63B31','#2F63D8','#F5B942','#F7C9B0'];
  for(var i=0;i<9;i++){
    var b=document.createElement('div');
    var s=10+Math.random()*14;
    b.style.cssText='position:fixed;left:'+x+'px;top:'+y+'px;width:'+s+'px;height:'+(s*1.2)+'px;'+
      'border-radius:50%;background:'+cols[i%4]+';pointer-events:none;z-index:200;opacity:.95;'+
      'transform:translate('+((Math.random()-.5)*160)+'px,0);animation:riseFade '+(1+Math.random())+'s ease-out forwards';
    document.body.appendChild(b);
    setTimeout(function(el){return function(){el.remove();};}(b),2100);
  }
}

function addToCart(ev){
  if(!state.size){
    document.getElementById('sizes').scrollIntoView({behavior:reduce?'auto':'smooth',block:'center'});
    setTimeout(function(){
      sizesEl.classList.add('shake');
      setTimeout(function(){sizesEl.classList.remove('shake');},500);
    }, reduce?0:520);
    return Promise.resolve(false);
  }
  if(!(state.variantId||BB.variantId) || !BB.available){
    alert('This size isn\u2019t available to order right now.');
    return Promise.resolve(false);
  }
  var btn=ev&&ev.currentTarget, txt=btn&&btn.textContent;
  if(btn){ btn.disabled=true; btn.textContent='Adding\u2026'; }
  return shopAdd(state.size, state.qty)
    .then(shopCart)
    .then(function(cart){
      renderCart(cart); openCart();
      if(ev&&ev.clientX) balloonBurst(ev.clientX,ev.clientY);
      return true;
    })
    .catch(function(e){ alert((e&&e.description)||'Could not add to cart.'); return false; })
    .finally(function(){ if(btn){ btn.disabled=false; btn.textContent=txt; } });
}
document.getElementById('addBtn').addEventListener('click',addToCart);
document.getElementById('bbBtn').addEventListener('click',addToCart);
document.getElementById('buyNow').addEventListener('click',function(e){ addToCart(e).then(function(ok){ if(ok) goCheckout(); }); });
document.getElementById('checkout').addEventListener('click',goCheckout);

/* ── Shopify AJAX cart: real line items, real checkout ── */
function shopAdd(size, qty){
  return fetch('/cart/add.js',{
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ items:[{ id: (state.variantId || BB.variantId), quantity: qty,
      properties: (state.variantId ? {} : (size ? { 'Size': size } : {})) }] })
  }).then(function(r){ return r.ok ? r.json() : r.json().then(function(e){ throw e; }); });
}
function shopCart(){ return fetch('/cart.js').then(function(r){ return r.json(); }); }
function goCheckout(e){ if(window.shiprocketCheckoutEvents&&shiprocketCheckoutEvents.buyCart){ try{ shiprocketCheckoutEvents.buyCart(e||null); return; }catch(err){} } location.href='/checkout'; }
/* ═══════════ sticky buy bar ═══════════ */
var bar=document.getElementById('buybar');
/* Keep a CTA on screen at all times: the bar shows once the main Add to cart
   has scrolled past, and hides again over the closing CTA. Plain scroll maths —
   no IntersectionObserver, so it can't be throttled into never firing. */
var ctaEl=document.getElementById('addBtn'), finalEl=document.querySelector('.final');
var barTick=false;
function syncBar(){
  barTick=false;
  if(!ctaEl||!finalEl) return;
  var c=ctaEl.getBoundingClientRect(), f=finalEl.getBoundingClientRect();
  var pastCta = c.bottom < 8;                    /* CTA is above the viewport */
  var atFinal = f.top < innerHeight * 0.65;      /* closing CTA is on screen   */
  bar.classList.toggle('on', pastCta && !atFinal);
}
addEventListener('scroll', function(){
  if(!barTick){ barTick=true; requestAnimationFrame(syncBar); }
},{passive:true});
addEventListener('resize', syncBar, {passive:true});
syncBar();
new MutationObserver(function(){
  document.documentElement.style.setProperty('--bar-h', bar.classList.contains('on') ? bar.offsetHeight+'px' : '0px');
}).observe(bar,{attributes:true,attributeFilter:['class']});

shopCart().then(renderCart).catch(function(){});
document.getElementById('yr').textContent=new Date().getFullYear();
syncAddBtn();
})();
</script>
