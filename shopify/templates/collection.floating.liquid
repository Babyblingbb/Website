.dot-live{width:8px;height:8px;border-radius:50%;background:var(--red);flex:none;animation:live 1.8s infinite}

.reviews{display:grid;gap:clamp(12px,2vw,20px);grid-template-columns:1fr}
@media(min-width:760px){.reviews{grid-template-columns:repeat(3,1fr)}}
.rev-card{background:#fff;border-radius:var(--r-m);padding:24px;box-shadow:var(--shadow-m);display:flex;flex-direction:column;gap:12px}
.rev-card .stars{font-size:.9rem}
.rev-card p{font-size:.95rem;color:var(--ink-2);flex:1}
.rev-who{display:flex;align-items:center;gap:10px;font-size:.83rem}
.av{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-weight:700;color:#fff;font-size:.8rem;flex:none}
.rev-who b{font-weight:600;display:block}
