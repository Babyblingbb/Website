.trust{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(10px,2vw,20px)}
@media(min-width:820px){.trust{grid-template-columns:repeat(4,1fr)}}
.tcard{background:rgba(255,255,255,.78);backdrop-filter:blur(12px);border-radius:var(--r-m);padding:22px 18px;text-align:center;
  box-shadow:var(--shadow-m),inset 0 0 0 1px rgba(255,255,255,.7)}
.tcard .em{font-size:1.7rem}
.tcard b{display:block;margin-top:8px;font-size:.95rem;font-weight:600}
.tcard span{font-size:.8rem;color:var(--ink-2)}

.faq{max-width:760px;margin-inline:auto;display:grid;gap:10px}
.q{background:rgba(255,255,255,.9);backdrop-filter:blur(12px);border-radius:var(--r-s);box-shadow:var(--shadow-m);overflow:hidden;transition:box-shadow .25s}
.q>button{width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 20px;text-align:left;font-weight:600;font-size:.98rem}
.q .ch{flex:none;width:26px;height:26px;border-radius:50%;background:var(--cream);display:grid;place-items:center;transition:transform .3s;font-size:1.1rem;line-height:1}
.q.open .ch{transform:rotate(45deg);background:var(--ink);color:#fff}
.q .a{max-height:0;overflow:hidden;transition:max-height .35s cubic-bezier(.4,0,.2,1)}
.q .a p{padding:0 20px 20px;color:var(--ink-2);font-size:.92rem}

.final{text-align:center;padding-block:clamp(66px,10vw,140px)}
.final h2{font-size:clamp(2.05rem,6.8vw,3.7rem);text-shadow:0 2px 26px rgba(255,255,255,.7)}
.final p{margin:16px auto 0;max-width:44ch;color:var(--ink-2)}

footer{background:var(--ink);color:#fff;padding-block:clamp(40px,6vw,70px) 30px;
  border-radius:var(--r-xl) var(--r-xl) 0 0;box-shadow:var(--shadow-l);position:relative;z-index:2}
