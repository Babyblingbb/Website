.f-bot{margin-top:36px;padding-top:20px;border-top:1px solid rgba(255,255,255,.14);display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap;font-size:.78rem;color:rgba(255,255,255,.5)}

/* ══════════════════════════ STICKY BUY BAR ══════════════════════════ */
#buybar{position:fixed;left:0;right:0;bottom:0;z-index:70;transform:translateY(110%);
  transition:transform .4s cubic-bezier(.22,1,.36,1);
  background:rgba(255,255,255,.86);backdrop-filter:blur(20px) saturate(1.5);
  box-shadow:0 -1px 0 rgba(255,255,255,.7),0 -14px 40px -24px rgba(20,70,110,.9);
  padding:10px var(--pad) calc(10px + env(safe-area-inset-bottom))}
#buybar.on{transform:translateY(0)}
.bb-in{max-width:var(--maxw);margin-inline:auto;display:flex;align-items:center;gap:12px}
.bb-thumb{width:46px;height:46px;border-radius:12px;background:var(--cream-2) url({{ 'bb-shirt.webp' | asset_url }}) center/150% no-repeat;flex:none;box-shadow:var(--shadow-s)}
.bb-txt{flex:1;min-width:0}
.bb-txt b{display:block;font-size:.86rem;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bb-txt span{font-size:.8rem;color:var(--ink-2)}
#buybar .btn{padding:14px 22px;font-size:.92rem;flex:none}
@media(min-width:960px){#buybar .btn{padding:14px 34px}}

/* ══════════════════════════ CART ══════════════════════════ */
#scrim{position:fixed;inset:0;background:rgba(14,47,76,.44);backdrop-filter:blur(4px);z-index:80;opacity:0;pointer-events:none;transition:opacity .3s}
#scrim.on{opacity:1;pointer-events:auto}
#cart{position:fixed;top:0;right:0;bottom:0;width:min(94vw,410px);z-index:90;background:var(--cream);
  transform:translateX(101%);transition:transform .42s cubic-bezier(.22,1,.36,1);display:flex;flex-direction:column;box-shadow:var(--shadow-l)}
#cart.on{transform:translateX(0)}
.cart-head{display:flex;align-items:center;justify-content:space-between;padding:20px var(--pad);border-bottom:1px solid var(--line)}
.cart-head h3{font-size:1.15rem}
.x{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:#fff;box-shadow:var(--shadow-s);font-size:1.1rem}
.cart-body{flex:1;overflow-y:auto;padding:20px var(--pad)}
.cart-empty{text-align:center;color:var(--ink-3);padding-top:60px}
.ci{display:flex;gap:14px;background:#fff;border-radius:var(--r-s);padding:12px;box-shadow:var(--shadow-s);animation:pop .35s cubic-bezier(.34,1.4,.64,1)}
.ci img{width:64px;height:64px;object-fit:contain;background:var(--cream-2);border-radius:10px;flex:none}
.ci .info{flex:1;min-width:0}
.ci b{font-size:.9rem;font-weight:600;display:block}
.ci small{color:var(--ink-3);font-size:.78rem}
.ci .row{display:flex;justify-content:space-between;align-items:center;margin-top:8px}
.ci .rm{font-size:.76rem;color:var(--ink-3);border-bottom:1px solid currentColor}
.cart-foot{padding:18px var(--pad) calc(18px + env(safe-area-inset-bottom));border-top:1px solid var(--line);background:#fff}
.cart-foot .tot{display:flex;justify-content:space-between;font-weight:600;margin-bottom:6px}
.cart-foot .note{font-size:.76rem;color:var(--ink-3);margin-bottom:14px}
.freebar{height:7px;border-radius:4px;background:var(--line);overflow:hidden;margin:10px 0 6px}
.freebar i{display:block;height:100%;border-radius:4px;background:linear-gradient(90deg,var(--green),#6fd3a1);width:0;transition:width .5s}

.rev{opacity:0;transform:translateY(28px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1)}
.rev.vis{opacity:1;transform:none}
.rev.d1{transition-delay:.08s}.rev.d2{transition-delay:.16s}.rev.d3{transition-delay:.24s}.rev.d4{transition-delay:.32s}

@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
  .rev{opacity:1;transform:none}
}


/* ══════════════════════════ SHOP GRID ══════════════════════════ */
.shop-head{text-align:center;max-width:640px;margin:0 auto clamp(26px,5vw,52px)}
.shop-head h1{font-size:clamp(2.1rem,7vw,3.6rem);letter-spacing:-.03em;
  text-shadow:0 2px 26px rgba(255,255,255,.85)}
.shop-head p{margin-top:12px;color:var(--ink-2);font-size:1.02rem}

.grid{display:grid;grid-template-columns:repeat(2,1fr);
  column-gap:clamp(6px,2vw,28px);row-gap:clamp(22px,4vw,52px)}
@media(max-width:679px){.grid{margin-inline:calc(-1 * var(--pad) + 4px);column-gap:2px}}
@media(min-width:680px){.grid{grid-template-columns:repeat(3,1fr)}}
@media(min-width:1000px){.grid{grid-template-columns:repeat(4,1fr)}}

.sh{display:flex;flex-direction:column;align-items:center;text-align:center;
  padding:4px 2px 0;border-radius:var(--r-m);
  transition:transform .35s cubic-bezier(.22,1,.36,1)}
.sh:active{transform:scale(.97)}
@media(hover:hover){.sh:hover{transform:translateY(-8px)}}

.sh-stage{position:relative;width:100%;aspect-ratio:10/11;display:grid;place-items:center}
.sh-stage img{width:100%;height:100%;object-fit:contain;position:relative;z-index:2;
  animation:floaty 7s ease-in-out infinite;
  filter:drop-shadow(0 26px 22px rgba(20,70,110,.24)) drop-shadow(0 6px 8px rgba(20,70,110,.10));
  transition:filter .35s}
@media(hover:hover){.sh:hover .sh-stage img{
  filter:drop-shadow(0 38px 30px rgba(20,70,110,.30)) drop-shadow(0 8px 10px rgba(20,70,110,.12))}}
.sh-stage .gr{position:absolute;left:50%;bottom:4%;width:52%;height:18px;translate:-50% 0;
  border-radius:50%;background:radial-gradient(ellipse,rgba(20,70,110,.26),rgba(20,70,110,0) 70%);
  filter:blur(7px);animation:shadowPulse 7s ease-in-out infinite}

.sh-name{margin-top:6px;font-family:'Fredoka';font-weight:600;line-height:1.15;
  font-size:clamp(.95rem,2.9vw,1.14rem);letter-spacing:-.01em}
.sh-price{margin-top:3px;font-size:clamp(.82rem,2.4vw,.95rem);color:var(--ink-2);font-weight:500}
.sh-price s{opacity:.55;margin-left:6px;font-weight:400}

/* stagger the float so the grid never pulses in unison */
.sh:nth-child(8n+2) .sh-stage img{animation-delay:-1.1s}
.sh:nth-child(8n+3) .sh-stage img{animation-delay:-2.3s}
.sh:nth-child(8n+4) .sh-stage img{animation-delay:-3.4s}
.sh:nth-child(8n+5) .sh-stage img{animation-delay:-4.2s}
.sh:nth-child(8n+6) .sh-stage img{animation-delay:-5.1s}
.sh:nth-child(8n+7) .sh-stage img{animation-delay:-2.8s}
.sh:nth-child(8n+8) .sh-stage img{animation-delay:-3.9s}
.sh:nth-child(2n) .sh-stage .gr{animation-delay:-2s}
.sh:nth-child(3n) .sh-stage .gr{animation-delay:-4s}

</style>
